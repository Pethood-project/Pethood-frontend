# Copiar a .env — NUNCA commitear .env
#
# En un celular físico usá la IP de tu PC, no localhost: en el celular localhost es el
# propio celular (ej. http://192.168.0.10:3000/api/v1).
#
# Se acepta con o sin el sufijo /api/v1 — el cliente normaliza las dos formas.
# Si se deja vacía, la app deduce la IP de la máquina que sirve Metro, lo que alcanza en
# la mayoría de los casos; conviene fijarla a mano cuando la PC tiene varias interfaces
# de red (WSL, VirtualBox, VPN) y Metro elige la equivocada.
EXPO_PUBLIC_API_URL="http://localhost:3000/api/v1"

# OAuth 2.0 Google — Client ID de tipo "Aplicación web" (también sirve en Expo Go)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=""
# Opcionales, para builds nativos
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=""
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=""
